# ============================================================
# .gitignore — Videomaker (subir apenas código-fonte)
# ============================================================

# --- Ambientes virtuais e dependências ---
.venv/
venv/
env/
node_modules/

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Sistema operacional ---
.DS_Store
Thumbs.db

# --- Logs ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Build / dist ---
ui/dist/
build/
dist/
*.pyc
__pycache__/

# --- Perfil do Chrome (credenciais, sessão Gemini) ---
.chrome-gemini-profile/

# --- Credenciais e configurações locais (NUNCA subir) ---
scripts/client_secret*.json
scripts/client_secre*.json*
scripts/client_*.json*
scripts/*token*.json
scripts/config.json
scripts/daily_config.json
scripts/pipeline_ui_settings.json
scripts/user_settings.json
scripts/youtube_token.json
# Estado local do setup do Google Flow (URL do projeto/lições por máquina)
.flow_learned_state.json
.env
.env.local

# --- Projetos gerados (não subir) ---
projects/
projects-deliveries.json*
scheduled_videos.json*
daily_state.json

# --- Banco de mídia local (não subir) ---
# Sem aspas: o git não entende aspas em padrões e buscaria as aspas no nome
banco de imagens/
banco de musicas/

# --- Estado local da interface ---
ui/test-results/
user_settings.json
scripts/pipeline_defaults.json

# --- Binários e executáveis (não subir) ---
ffmpeg/

# --- Espaço de trabalho do HyperFrames (gerado) ---
hyperframes-workspace/

# --- Vídeos e imagens gerados (não subir) ---
*.mp4
*.jpg
*.jpeg
*.png
*.wav
*.m4a

# --- Temporário ---
*.tmp
scripts/.narration_voice_state.json
